{
  "manifest_version": 3,

  "name": "CyberAware Browser Protection",

  "version": "1.0.0",

  "description": "Protects users from suspicious and phishing websites.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["tabs", "storage", "scripting"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "CyberAware Browser Protection",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["risk-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
